{
  "name": "domaine-des-reves-bleus-backend",
  "version": "2.0.0",
  "description": "Backend Node.js pour Domaine des Rêves Bleus - Migration depuis FastAPI",
  "main": "server.js",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "init-categories": "node scripts/init-categories.js",
    "init-services": "node scripts/init-services.js"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "stripe": "^20.4.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "cross-spawn": "^7.0.5",
      "path-to-regexp": "^8.4.0",
      "minimatch": "^9.0.7",
      "glob": "^10.5.0",
      "lodash": "^4.18.0"
    },
    "onlyBuiltDependencies": [
      "bcrypt"
    ],
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
